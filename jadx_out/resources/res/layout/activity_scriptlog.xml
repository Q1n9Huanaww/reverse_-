<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:orientation="1"
    ns0:background="#ffffffff"
    ns0:layout_width="-1"
    ns0:layout_height="-1">
    <com.p024ds.daisi.customview.TitleView
        ns0:id="@+id/titleview_scriptlog"
        style="@style/titleview"/>
    <ListView
        ns0:id="@+id/listview_scriptlog"
        ns0:padding="7dp"
        ns0:layout_width="-1"
        ns0:layout_height="0dp"
        ns0:listSelector="#ffffffff"
        ns0:divider="@android:color/transparent"
        ns0:dividerHeight="5dp"
        ns0:layout_weight="1"/>
    <LinearLayout
        ns0:orientation="0"
        ns0:paddingLeft="15dp"
        ns0:paddingTop="10dp"
        ns0:paddingRight="15dp"
        ns0:paddingBottom="10dp"
        ns0:layout_width="-1"
        ns0:layout_height="-2">
        <Button
            ns0:textColor="@android:color/white"
            ns0:id="@+id/btn_scriptlog_removeall"
            ns0:background="#ff3c7ac5"
            ns0:visibility="2"
            ns0:layout_width="-2"
            ns0:layout_height="40dp"
            ns0:text="@string/scriptlog_removeall"
            ns0:layout_weight="4"/>
        <Button
            ns0:textColor="@android:color/white"
            ns0:id="@+id/btn_scriptlog_selectall"
            ns0:background="#ff3c7ac5"
            ns0:visibility="2"
            ns0:layout_width="-2"
            ns0:layout_height="40dp"
            ns0:layout_marginLeft="5dp"
            ns0:text="@string/scriptlog_selectall"
            ns0:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
