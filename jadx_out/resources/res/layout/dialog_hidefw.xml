<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:gravity="0x11"
    ns0:orientation="1"
    ns0:background="#ffffffff"
    ns0:padding="10dp"
    ns0:layout_width="-1"
    ns0:layout_height="-1">
    <TextView
        ns0:textAppearance="?android:attr/textAppearanceMedium"
        ns0:id="@+id/textView1"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:text="@string/hidefw_tip_title"/>
    <TextView
        ns0:textAppearance="?android:attr/textAppearanceMedium"
        ns0:gravity="0x11"
        ns0:id="@+id/textView2"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:text="@string/hidefw_tip_content"
        ns0:layout_weight="1"/>
    <LinearLayout
        ns0:layout_width="-1"
        ns0:layout_height="-2">
        <Button
            ns0:textColor="@color/gray2"
            ns0:id="@+id/hidefw_button_cancel"
            ns0:background="@drawable/scriptui_button_bg_gray"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:layout_marginRight="10dp"
            ns0:minHeight="35dp"
            ns0:text="@string/hidefw_cancel"
            ns0:layout_weight="1"/>
        <Button
            ns0:textColor="@color/blue1"
            ns0:id="@+id/hidefw_button_ok"
            ns0:background="@drawable/scriptui_button_bg_blue"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:minHeight="35dp"
            ns0:text="@string/hidefw_ok"
            ns0:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
