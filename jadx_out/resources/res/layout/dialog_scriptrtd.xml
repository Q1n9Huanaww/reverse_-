<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:gravity="0x11"
    ns0:orientation="1"
    ns0:background="#ffffffff"
    ns0:layout_width="-1"
    ns0:layout_height="-1">
    <TextView
        ns0:textAppearance="?android:attr/textAppearanceLargeInverse"
        ns0:textColor="@android:color/black"
        ns0:id="@+id/scriptrtd_textview_title"
        ns0:padding="10dp"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:text="@string/scriptrtd_instructions"/>
    <TextView
        ns0:textAppearance="?android:attr/textAppearanceLargeInverse"
        ns0:gravity="0x11"
        ns0:id="@+id/scriptrtd_textview_nortd"
        ns0:padding="10dp"
        ns0:visibility="2"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:text="@string/scriptrtd_nortd"
        ns0:layout_weight="1"/>
    <WebView
        ns0:id="@+id/scriptrtd_webview"
        ns0:layout_width="-1"
        ns0:layout_height="-1"
        ns0:layout_marginBottom="10dp"
        ns0:layout_weight="1"/>
</LinearLayout>
