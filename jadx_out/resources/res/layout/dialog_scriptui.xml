<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:gravity="0x11"
    ns0:orientation="1"
    ns0:id="@+id/ll_dialog_ui_root"
    ns0:background="#ffffffff"
    ns0:padding="10dp"
    ns0:layout_width="-1"
    ns0:layout_height="-1">
    <LinearLayout
        ns0:gravity="0x11"
        ns0:orientation="0"
        ns0:layout_width="-1"
        ns0:layout_height="-2">
        <ImageView
            ns0:visibility="1"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:src="@drawable/scriptui_setting"/>
        <TextView
            ns0:textAppearance="?android:attr/textAppearanceLarge"
            ns0:gravity="0x11"
            ns0:id="@+id/textView1"
            ns0:layout_width="0dp"
            ns0:layout_height="-2"
            ns0:text="@string/scriptui_uisetting"
            ns0:layout_weight="1"/>
        <ImageView
            ns0:id="@+id/scriptui_imageview_setting"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:src="@drawable/scriptui_setting"/>
    </LinearLayout>
    <LinearLayout
        ns0:orientation="1"
        ns0:id="@+id/ll_dialog_ui_parent"
        ns0:padding="10dp"
        ns0:layout_width="-1"
        ns0:layout_height="0dp"
        ns0:layout_weight="1">
        <ScrollView
            ns0:id="@+id/scriptui_scrollview"
            ns0:layout_width="-1"
            ns0:layout_height="-1">
            <LinearLayout
                ns0:gravity="0x11"
                ns0:orientation="1"
                ns0:id="@+id/scriptui_linearlayout_ui"
                ns0:layout_width="-1"
                ns0:layout_height="-2"/>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        ns0:gravity="0x10"
        ns0:padding="10dp"
        ns0:layout_width="-1"
        ns0:layout_height="-2">
        <Button
            ns0:textColor="@color/blue1"
            ns0:id="@+id/scriptui_button_savesetting"
            ns0:background="@drawable/scriptui_button_bg_blue"
            ns0:text="@string/scriptui_savesetting"
            style="@style/scriptui_button"/>
    </LinearLayout>
</LinearLayout>
