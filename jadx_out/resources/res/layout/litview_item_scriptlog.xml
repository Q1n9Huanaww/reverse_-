<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:gravity="0x10"
    ns0:orientation="0"
    ns0:background="#ffffffff"
    ns0:padding="10dp"
    ns0:layout_width="-1"
    ns0:layout_height="-2"
    ns0:layout_margin="15dp">
    <TextView
        ns0:textSize="12sp"
        ns0:textColor="@android:color/white"
        ns0:gravity="0x51"
        ns0:id="@+id/tv_listviewitem_scriptlog_size"
        ns0:background="@drawable/ic_scriptlog"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:text="123KB"/>
    <TextView
        ns0:textSize="18sp"
        ns0:textColor="@color/gray2"
        ns0:id="@+id/tv_listviewitem_scriptlog_name"
        ns0:layout_width="0dp"
        ns0:layout_height="-2"
        ns0:layout_marginLeft="20dp"
        ns0:text="2014-10-09"
        ns0:layout_weight="1"/>
    <CheckBox
        ns0:id="@+id/cb_listviewitem_scriptlog_select"
        ns0:visibility="2"
        ns0:layout_width="-2"
        ns0:layout_height="-2"/>
    <ImageView
        ns0:id="@+id/img_listviewitem_scriptlog_select"
        ns0:layout_width="-2"
        ns0:layout_height="-2"
        ns0:src="@drawable/ic_arrow_right"/>
</LinearLayout>
