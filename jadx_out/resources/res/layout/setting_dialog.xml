<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android"
    ns0:gravity="0x11"
    ns0:orientation="1"
    ns0:background="#ffffffff"
    ns0:layout_width="-1"
    ns0:layout_height="-1">
    <LinearLayout
        ns0:gravity="0x11"
        ns0:orientation="0"
        ns0:layout_width="-1"
        ns0:layout_height="-2">
        <ImageView
            ns0:id="@+id/setting_dialog_imageview_back"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:src="@drawable/setting_arrow_left"/>
        <TextView
            ns0:textAppearance="?android:attr/textAppearanceLarge"
            ns0:textColor="@color/gray2"
            ns0:gravity="0x11"
            ns0:id="@+id/textView1"
            ns0:padding="7dp"
            ns0:layout_width="-1"
            ns0:layout_height="-2"
            ns0:text="设置"
            ns0:layout_weight="1"/>
        <ImageView
            ns0:visibility="1"
            ns0:layout_width="-2"
            ns0:layout_height="-2"
            ns0:src="@drawable/setting_arrow_left"/>
    </LinearLayout>
    <ScrollView
        ns0:layout_width="-1"
        ns0:layout_height="0dp"
        ns0:layout_weight="1">
        <LinearLayout
            ns0:orientation="1"
            ns0:layout_width="-1"
            ns0:layout_height="-2">
            <Switch
                ns0:id="@+id/setting_swtich_volume_key_ctrl"
                ns0:text="@string/setting_volume_key_ctrl"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/setting_swtich_floatview_ctrl"
                ns0:text="@string/setting_floatview_ctrl"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/setting_swtich_waggle_stop"
                ns0:text="@string/setting_waggle_stop"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/setting_swtich_call_stop"
                ns0:text="@string/setting_call_stop"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/setting_swtich_vibration"
                ns0:text="@string/setting_vibration"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/setting_swtich_open_run"
                ns0:checked="false"
                ns0:text="@string/setting_open_run_script"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Switch
                ns0:id="@+id/switch_setting_word_recognition_library"
                ns0:clickable="false"
                ns0:text="@string/word_recognition_library"
                style="@style/setting_switch"/>
            <View style="@style/setting_splitline"/>
            <Button
                ns0:textSize="16sp"
                ns0:textColor="@color/gray2"
                ns0:gravity="0x13"
                ns0:id="@+id/setting_button_scriptlog"
                ns0:background="@android:color/transparent"
                ns0:paddingLeft="15dp"
                ns0:layout_width="-1"
                ns0:layout_height="-2"
                ns0:text="@string/setting_scriptlog"
                ns0:drawableRight="@drawable/setting_arrow_right"/>
            <View style="@style/setting_splitline"/>
            <Button
                ns0:textSize="16sp"
                ns0:textColor="@color/gray2"
                ns0:gravity="0x13"
                ns0:id="@+id/setting_button_update"
                ns0:background="@android:color/transparent"
                ns0:paddingLeft="15dp"
                ns0:visibility="2"
                ns0:layout_width="-1"
                ns0:layout_height="-2"
                ns0:text="@string/setting_update"/>
            <View style="@style/setting_splitline"/>
            <Button
                ns0:textSize="16sp"
                ns0:textColor="@color/gray2"
                ns0:gravity="0x13"
                ns0:id="@+id/setting_button_exitapp"
                ns0:background="@android:color/transparent"
                ns0:paddingLeft="15dp"
                ns0:layout_width="-1"
                ns0:layout_height="-2"
                ns0:text="@string/scriptui_exitapp"/>
            <View style="@style/setting_splitline"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
